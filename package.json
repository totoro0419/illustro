{
  "name": "illustro",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "core:typecheck": "npm --workspace @illustro/core run typecheck",
    "core:test": "npm --workspace @illustro/core run test",
    "core:check": "npm run core:typecheck && npm run core:test",
    "brush:typecheck": "npm --workspace @illustro/brush run typecheck",
    "brush:test": "npm --workspace @illustro/brush run test",
    "brush:lab": "node prototypes/brush-lab/build.mjs",
    "brush:benchmark": "node prototypes/brush-lab/build-benchmark.mjs && node --expose-gc benchmark-dist/benchmark.mjs",
    "brush:browser": "node prototypes/brush-lab/browser-check.mjs",
    "brush:check": "npm run brush:typecheck && npm run brush:test && npm run core:check",
    "brush:atlas": "node prototypes/brush-lab/build-atlas.mjs",
    "brush:latency": "node prototypes/brush-lab/latency-check.mjs"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "playwright-core": "1.63.0"
  }
}
