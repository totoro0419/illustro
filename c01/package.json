{
  "name": "illustro-c01",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target ES2022 --module ES2022 --lib ES2022,DOM,DOM.Iterable app/model.mjs",
    "lint": "node --check app/model.mjs && node --check app/main.mjs && node --check app/raster-worker.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "browser:test": "node test/browser-test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "playwright": "^1.56.1"
  }
}
